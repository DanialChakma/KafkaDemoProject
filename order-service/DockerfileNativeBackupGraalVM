# ============================
# Stage 1: Build native image
# ============================
FROM ghcr.io/graalvm/native-image-community:17 AS build

WORKDIR /app

# Copy Maven wrapper and pom.xml first to cache dependencies
COPY .mvn/ .mvn/
COPY mvnw .
COPY pom.xml .

# Make Maven wrapper executable
RUN chmod +x mvnw


RUN ./mvnw dependency:go-offline -B

# Copy source code
COPY src ./src

# Build native image using Spring AOT
RUN ./mvnw clean package -Pnative -DskipTests \
    -Dspring-boot.native-image.buildArgs="--no-fallback" \
    -Dspring-boot.native-image.container-build=true

RUN ls -lh /app/target/
RUN ls -lh /app/target/*  # to see files directly

# ============================
# Stage 2: Runtime
# ============================
# Switch from distroless to slim Debian to support dynamically linked binaries
FROM debian:bullseye-slim

WORKDIR /app

# Install libz and other dependencies GraalVM native image might need
#RUN apt-get update && apt-get install -y libc6 libz3 && rm -rf /var/lib/apt/lists/*

# Copy native executable from build stage
#COPY --from=build /app/target/*-runner /app/order-service

# Copy native binary from build stage
COPY --from=build /app/target/order-service /app/order-service

RUN chmod +x /app/order-service

# Use non-root user
RUN useradd -m appuser
USER appuser

# Expose application port
EXPOSE 8086

# Run the native executable
ENTRYPOINT ["/app/order-service"]
