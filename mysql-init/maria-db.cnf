[mysqld]

# ----------------------
# Basic Settings
# ----------------------
user            = mysql
port            = 3306
skip-host-cache
skip-name-resolve
sql_mode        = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION
default_storage_engine = InnoDB
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# ----------------------
# Memory Optimization
# ----------------------
innodb_buffer_pool_size = 32M       # main InnoDB buffer (reduce for dev)
innodb_log_buffer_size   = 8M       # log buffer
innodb_flush_log_at_trx_commit = 2  # faster for dev/test
innodb_file_per_table    = 1        # separate files per table

max_connections          = 10       # limit concurrent connections
table_open_cache         = 32       # number of table descriptors
thread_cache_size        = 4

query_cache_type         = 0        # disable query cache (deprecated)
query_cache_size         = 0

tmp_table_size           = 8M
max_heap_table_size      = 8M

# ----------------------
# Logging (optional)
# ----------------------
slow_query_log           = 0
general_log              = 0
log_error                = /var/lib/mysql/mysql_error.log

# ----------------------
# InnoDB I/O tuning
# ----------------------
innodb_flush_method      = O_DIRECT
innodb_thread_concurrency = 2

# ----------------------
# Networking
# ----------------------
skip-external-locking
back_log                 = 25
